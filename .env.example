# --- Meta app (Instagram API with Instagram Login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any random string. Paste the same value into the Meta webhook configuration.
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v21.0

# --- Single-account shortcut (optional) ---
# Skip the "Connect Instagram" flow by pasting a long-lived token + the IG user id it belongs to.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- App ---
# Public URL of this deployment, no trailing slash (e.g. https://convertlysocial.vercel.app)
APP_URL=
# Password for the dashboard (username is "admin")
ADMIN_PASSWORD=
# Vercel sends this in the Authorization header when it runs the token-refresh cron
CRON_SECRET=
# Log every incoming webhook body while you set things up
DEBUG_WEBHOOKS=false

# --- Supabase (recommended; without it rules are in-memory) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- No-database mode (optional) ---
# JSON array of automations, e.g.
# [{"name":"Guide","keywords":["guide"],"publicReplies":["Sent! 💌"],"dmText":"Here you go {{username}}: {{link}}","dmLink":"https://example.com"}]
AUTOMATIONS_JSON=
